root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# YAML forbids tabs; Markdown lists and frontmatter are space-aligned.
[*.{yml,yaml,md,mdx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
