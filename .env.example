# Copy this file to `.env` and fill in what you need. Never commit `.env`.
# Every variable is optional: the public site runs with none of them.
# Variables are declared and validated in `src/env.ts`.

# --- Database (admin sessions and newsletter) --------------------------------
# Postgres connection string from Neon (Vercel or Netlify integration).
# Without it, a local PGlite database is created in `.data/pglite`.
DATABASE_URL=
# Folder of the local PGlite database. "memory://" keeps it in RAM (tests).
PGLITE_DIR=

# --- Admin authentication (/admin) ------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://example.com. Inferred from the request when empty.
BETTER_AUTH_URL=
# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: <site origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed into /admin. Empty means nobody.
ADMIN_GITHUB_USERS=
# Comma-separated e-mails allowed into /admin. Needed for Google; only verified addresses count.
ADMIN_EMAILS=
# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enables a login shortcut for automated tests. Never set it in production.
AUTH_TEST_LOGIN_TOKEN=

# --- Content storage ----------------------------------------------------------
# Fine-grained token with "Contents: Read and write" on GITHUB_REPO only.
# Without it, /admin writes to the local disk (development).
GITHUB_TOKEN=
# Repository that holds the content, as "owner/name".
GITHUB_REPO=
# Branch that receives content commits. Defaults to "main".
GITHUB_BRANCH=
# Project root used by the local disk store. Defaults to the working directory.
CONTENT_ROOT=

# --- E-mail (contact form and newsletter) -----------------------------------
# Without RESEND_API_KEY, e-mails are logged to the console instead of sent.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown to recipients. The domain must be verified in Resend.
RESEND_FROM_EMAIL="My Blog <no-reply@example.com>"
# Inbox that receives contact form messages. Defaults to `contactEmail` in src/lib/site.config.ts.
CONTACT_TO_EMAIL=
# Bearer token accepted by the newsletter dispatch endpoint when called by a scheduler.
# At least 32 characters; generate with: openssl rand -base64 32
CRON_SECRET=

# --- Post import (/admin/import) ---------------------------------------------
# Mistral API key (the free "Experiment" plan works): https://console.mistral.ai/api-keys
# When set, the import rewrites the source summary and FAQ. Without it, the draft gets template texts.
MISTRAL_API_KEY=
