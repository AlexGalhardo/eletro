# Copy this file to `.env` and fill in what you need. Never commit `.env`.
# Every variable is optional: the public site runs with none of them.
# Variables are declared and validated in `src/env.ts`.

# --- E-mail (contact form and newsletter) ----------------------------------
# Without RESEND_API_KEY, e-mails are logged to the console instead of sent.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown to recipients. The domain must be verified in Resend.
RESEND_FROM_EMAIL="My Blog <no-reply@example.com>"
# Inbox that receives contact form messages. Defaults to `contactEmail` in src/lib/site.config.ts.
CONTACT_TO_EMAIL=
