{
  "name": "eletroradar",
  "scripts": {
    "dev": "rm -rf ./.next && next dev",
    "build": "bun run update-dates && bun run create-sitemap && bun run check-mdx && bun run check-sitemap && bun run format && next build",
    "start": "bun run build && next start",
    "lint": "next lint",
    "linter": "biome check app/ components/ --fix --unsafe",
    "format": "bun run update-dates && biome format app/ data/ components/ emails/ lib/ hooks/ scripts/ --fix",
    "husky": "bunx husky",
    "update-dates": "bun ./scripts/update-dates.ts",
    "check-mdx": "bun ./scripts/check-mdx.ts en",
    "check-sitemap": "bun scripts/check-sitemap.ts en",
    "create-sitemap": "bun run ./scripts/create-sitemap.ts && bun run ./scripts/update-indexnow.ts"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
      "biome check --apply --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@biomejs/biome": "2.5.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/clipboard": "^2.0.10",
    "@types/mdx": "^2.0.14",
    "@types/nprogress": "^0.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/xlsx": "^0.0.36",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "creem": "1.5.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "install": "^0.13.0",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-share": "^0.27.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "nprogress": "^0.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.6.9",
    "react-i18next": "^17.0.9",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.1",
    "reading-time": "^1.5.0",
    "resend": "^6.17.2",
    "swiper": "^14.0.5",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.0"
  }
}
