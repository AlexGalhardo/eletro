{
	"name": "eletroradar.com.br",
	"description": "Open source blog CMS built with Astro 7.4, Markdown content and a web admin dashboard.",
	"version": "0.10.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "bun scripts/check-env.ts && bun scripts/sync-links.ts && bun scripts/cover-variants.ts && astro build",
		"check-env": "bun scripts/check-env.ts",
		"sync-links": "bun scripts/sync-links.ts",
		"post-status": "bun scripts/post-status.ts",
		"preview": "astro preview",
		"prepare": "husky || echo ''",
		"check": "tsc --noEmit",
		"lint": "biome check . && markdownlint-cli2",
		"lint:code": "biome check .",
		"lint:md": "markdownlint-cli2",
		"format": "biome check --write . && markdownlint-cli2 --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"verify": "bun run check && bun run lint && bun run test && bun run build && bun run test:e2e"
	},
	"imports": {
		"#env": "./src/env.ts",
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.8",
		"@fontsource/inter": "5.3.0",
		"@fontsource/russo-one": "5.3.0",
		"@fontsource/space-grotesk": "5.3.0",
		"@neondatabase/serverless": "1.2.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@ui-sdk/core": "0.1.0-beta.1",
		"better-auth": "1.7.7",
		"cheerio": "1.2.0",
		"clipboard": "2.0.11",
		"drizzle-orm": "0.45.3",
		"fuse.js": "7.5.0",
		"gray-matter": "4.0.3",
		"marked": "18.1.0",
		"opentype.js": "2.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"resend": "6.32.0",
		"sharp": "0.35.5",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.4.7",
		"drizzle-kit": "0.31.11",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.23.3",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
