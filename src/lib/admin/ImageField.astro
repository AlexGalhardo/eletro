---
import { ui } from "#lib/admin/api.ts";
import Lucide from "#lib/components/Lucide.astro";

interface Props {
	value?: string;
	label: string;
	folder: "covers" | "posts";
	options?: string[];
	id: string;
}

const { value = "", label, folder, options = [], id } = Astro.props;
---

<div data-image-field data-folder={folder}>
	<label for={id} class={ui.label}>{label}</label>
	<div class="flex gap-2">
		<input
			id={id}
			data-image-url
			value={value}
			list={`${id}-options`}
			placeholder={`/images/${folder}/arquivo.webp`}
			class={ui.input}
		/>
		<label class:list={[ui.button, "mt-1 shrink-0 cursor-pointer"]}>
			<Lucide name="upload" class="h-3.5 w-3.5" />
			<span data-image-button>Enviar</span>
			<input
				data-image-file
				type="file"
				accept="image/webp,image/jpeg,image/png"
				class="sr-only"
				aria-label={`Enviar imagem: ${label}`}
			/>
		</label>
	</div>
	<datalist id={`${id}-options`}>
		{options.map((option) => <option value={option} />)}
	</datalist>
	<img
		data-image-preview
		alt={`Pré-visualização: ${label}`}
		hidden
		class:list={[
			"mt-2 rounded border border-gray-200 bg-white dark:border-zinc-800",
			folder === "covers" ? "aspect-video w-full max-w-sm object-cover" : "h-32 w-32 object-contain",
		]}
	/>
	<p data-image-broken hidden class="mt-1 text-xs text-gray-500">
		A imagem não carregou. Confira o endereço; um arquivo enviado há pouco só aparece depois do deploy.
	</p>
	<p data-image-error hidden role="alert" class="mt-1 text-sm text-red-600 dark:text-red-400"></p>
</div>

<script>
	import { bindImageFields } from "#lib/client/image-field.ts";

	bindImageFields();
</script>
