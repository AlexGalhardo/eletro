---
interface Props {
	errors?: string[];
	success?: string;
}

const { errors = [], success = "" } = Astro.props;
---

{
	errors.length > 0 ? (
		<ul role="alert" class="space-y-1 rounded-lg border border-red-300 bg-red-50 px-4 py-3 dark:border-red-900 dark:bg-red-950">
			{errors.map((message) => (
				<li class="text-sm text-red-700 dark:text-red-300">{message}</li>
			))}
		</ul>
	) : (
		success && (
			<p
				role="status"
				class="rounded-lg border border-border bg-muted px-4 py-3 text-sm text-foreground"
			>
				{success}
			</p>
		)
	)
}
