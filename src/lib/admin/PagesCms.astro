---
import { referencedLists } from "#lib/content/parse.ts";
import { getBundledPostSources } from "#lib/server/content.ts";
import { site } from "#lib/site.config.ts";

interface Props {
	folder: string;
}

const { folder } = Astro.props;
const repo = site.githubRepo;
const postLinks = Object.fromEntries(
	[...getBundledPostSources()].map(([slug, raw]) => [slug, referencedLists(raw)]),
);
---

<div data-pages-cms data-repo={repo} data-folder={folder} data-post-links={JSON.stringify(postLinks)} class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
	<header data-workspace-header hidden class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-border pb-6 ">
		<div>
			<h1 class="font-russo-one text-3xl tracking-tight">Painel editorial</h1>
			<p class="mt-2 max-w-2xl text-sm text-muted-foreground ">
				Edite os arquivos do blog. O painel salva em uma branch e abre um PR para revisão antes da publicação.
			</p>
		</div>
	</header>

	<section data-workspace hidden class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
		<aside class="rounded-2xl border border-border bg-card p-4 ">
			<h2 class="px-2 text-sm font-bold">Conteúdo</h2>
			<nav aria-label="Tipos de conteúdo" class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-1">
				<button type="button" data-folder="content/posts" class="rounded-lg px-3 py-2 text-left text-sm hover:bg-muted ">Posts</button>
				<button type="button" data-folder="content/products" class="rounded-lg px-3 py-2 text-left text-sm hover:bg-muted ">Produtos</button>
				<button type="button" data-folder="content" class="rounded-lg px-3 py-2 text-left text-sm hover:bg-muted ">Configuração JSON</button>
				<button type="button" data-folder="static/images" class="rounded-lg px-3 py-2 text-left text-sm hover:bg-muted ">Imagens</button>
			</nav>
			<div class="mt-5 border-t border-border pt-4 ">
				<label for="file-search" class="text-xs font-semibold">Buscar arquivo</label>
				<input id="file-search" type="search" placeholder="Nome do arquivo" class="mt-2 w-full rounded-lg border border-input bg-card px-3 py-2 text-sm " />
				<ul data-files class="cms-scroll mt-3 h-96 space-y-1 overflow-y-scroll text-sm"></ul>
			</div>
		</aside>
		<div class="min-w-0 space-y-6">
			<section data-text-panel class="rounded-2xl border border-border bg-card p-5 sm:p-7">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<h2 class="text-xl font-bold">Editor de arquivos</h2>
						<p data-path class="mt-1 break-all text-sm text-muted-foreground">Selecione um arquivo ou crie um novo.</p>
					</div>
					<button type="button" data-new class="rounded-lg border border-input px-3 py-2 text-sm font-semibold hover:bg-muted ">Novo arquivo</button>
				</div>
					<div data-post-fields hidden class="mt-6 space-y-4 border-t border-border pt-5 ">
						<div class="grid gap-4 sm:grid-cols-2">
							<label class="text-sm font-semibold">Slug<input data-post-field="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 " /></label>
							<label class="text-sm font-semibold">Data de publicação<input data-post-field="date" type="date" required class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 " /></label>
						</div>
						<label class="block text-sm font-semibold">Título<input data-post-field="title" required class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 " /></label>
						<label class="block text-sm font-semibold">Descrição<input data-post-field="description" class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 " /></label>
						<div class="grid gap-4 sm:grid-cols-3">
							<label class="text-sm font-semibold">Categoria<select data-post-field="category" class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 ">{site.categories.map((category) => <option value={category.id}>{category.label}</option>)}</select></label>
							<label class="text-sm font-semibold">Autor<select data-post-field="author" class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 ">{Object.entries(site.authors).map(([id, author]) => <option value={id}>{author.name}</option>)}</select></label>
							<label class="flex items-end gap-2 pb-2 text-sm font-semibold"><input data-post-field="draft" type="checkbox" class="h-4 w-4" /> Rascunho</label>
						</div>
						<label class="block text-sm font-semibold">Capa<input data-post-field="cover" placeholder="/images/covers/arquivo.webp" class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 " /></label>
						<img data-cover-preview alt="Prévia da capa" hidden class="aspect-video max-h-56 w-full rounded-lg border border-border bg-muted object-contain " />
						<div class="flex flex-wrap items-end gap-2 border-t border-border pt-4 "><label class="min-w-52 flex-1 text-sm font-semibold">Lista de produtos<select data-product-choice class="mt-1 block w-full rounded-lg border border-input bg-card px-3 py-2 "><option value="">Escolha um JSON</option></select></label><button type="button" data-link-product class="rounded-lg border border-input px-4 py-2 text-sm font-semibold hover:bg-muted ">Vincular lista</button></div>
					</div>
				<label for="editor" class="mt-6 block text-sm font-semibold">Conteúdo MDX ou JSON</label>
					<textarea id="editor" data-editor rows="22" spellcheck="false" class="cms-scroll mt-2 w-full rounded-lg border border-input bg-muted p-4 font-mono text-sm leading-6 focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 "></textarea>
					<div data-content-images class="mt-4 flex flex-wrap gap-2"></div>
					<div data-relations class="mt-4 text-sm"></div>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<button type="button" data-save class="rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary/90 disabled:opacity-50">Salvar no GitHub</button>
					<span class="text-xs text-muted-foreground">Revise o conteúdo antes de publicar. O build valida MDX e JSON.</span>
				</div>
			</section>
				<section data-image-panel hidden class="rounded-2xl border border-border bg-card p-5 sm:p-7"><h2 class="text-xl font-bold">Prévia da imagem</h2><p data-image-path class="mt-2 break-all text-sm text-muted-foreground"></p><img data-image-detail alt="Imagem selecionada" class="mt-4 max-h-[28rem] w-full rounded-lg border border-border bg-muted object-contain " /><button type="button" data-use-cover hidden class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">Usar como capa</button></section>
			<section class="rounded-2xl border border-border bg-card p-5 sm:p-7">
				<h2 class="text-xl font-bold">Enviar imagem</h2>
				<p class="mt-2 text-sm text-muted-foreground ">PNG, JPEG ou WebP até 4 MB. O arquivo é salvo em <code>static/images/</code>.</p>
				<form data-upload-form class="mt-4 flex flex-wrap items-end gap-3">
					<label class="text-sm font-semibold">Pasta
						<select name="folder" class="mt-1 block rounded-lg border border-input bg-card px-3 py-2 "><option value="covers">Capas</option><option value="posts">Posts</option></select>
					</label>
					<label class="text-sm font-semibold">Arquivo
						<input name="image" type="file" accept="image/png,image/jpeg,image/webp" required class="mt-1 block max-w-full text-sm" />
					</label>
					<button type="submit" class="rounded-lg border border-input px-4 py-2 text-sm font-semibold hover:bg-muted ">Enviar</button>
				</form>
					<div data-upload-preview hidden class="mt-4"><p data-upload-name class="mb-2 break-all text-sm text-muted-foreground "></p><img data-upload-image alt="Prévia da imagem para upload" class="max-h-64 w-full rounded-lg border border-border bg-muted object-contain " /></div>
			</section>
		</div>
	</section>
	<p data-message role="status" aria-live="polite" class="mx-auto mt-5 max-w-2xl text-center text-sm font-medium"></p>
	<p class="mt-3 text-center"><a data-review href="https://github.com" hidden target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary underline ">Abrir pull request no GitHub</a></p>
</div>

<style>
	:global(html:has([data-pages-cms])) { overflow-y: scroll; scrollbar-gutter: stable; }
	:global(html:has([data-pages-cms])) ::-webkit-scrollbar { width: 12px; height: 12px; }
	:global(html:has([data-pages-cms])) ::-webkit-scrollbar-track { background: var(--muted); }
	:global(html:has([data-pages-cms])) ::-webkit-scrollbar-thumb { background: var(--input); border: 2px solid var(--muted); border-radius: 8px; }
	.cms-scroll { scrollbar-width: auto; scrollbar-gutter: stable; scrollbar-color: var(--input) var(--muted); }
</style>

<script>
	import { initPagesCms } from "#lib/admin/pages-cms.ts";

	initPagesCms();
</script>
