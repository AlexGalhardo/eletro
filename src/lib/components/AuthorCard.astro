---
import { type AuthorId, site } from "#lib/site.config.ts";

interface Props {
	id: string;
	class?: string;
}

const { id, class: className = "" } = Astro.props;
const author = site.authors[id as AuthorId];

const palette = author
	? { card: "border-border bg-card", avatar: "border-primary", role: "text-primary" }
	: undefined;
---

{
	author && palette && (
		<div class:list={["flex items-center gap-4 rounded-xl border p-4", palette.card, className]}>
			<img
				src={author.avatar}
				alt={author.name}
				width="56"
				height="56"
				loading="lazy"
				class:list={["h-14 w-14 flex-shrink-0 rounded-full border-2 object-cover", palette.avatar]}
			/>
			<div>
				<div class="flex items-center gap-2">
					<span class="font-semibold text-foreground normal-case ">{author.name}</span>
					<span class:list={["text-xs font-medium normal-case", palette.role]}>{author.role}</span>
				</div>
				<p class="mt-1 text-sm leading-relaxed text-muted-foreground normal-case ">{author.bio}</p>
			</div>
		</div>
	)
}
