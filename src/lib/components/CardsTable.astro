---
import { isAffiliateUrl } from "#lib/affiliate-links.ts";
import { offerTarget, specifiedDetails } from "#lib/content/review.ts";
import type { Product } from "#lib/content/schema.ts";
import Icon from "./Icon.astro";
import OfferButton from "./OfferButton.astro";

interface Props {
	list: string;
	products: Product[];
	postSlug: string;
	shuffle?: boolean;
}

const { list, products: source, postSlug, shuffle = true } = Astro.props;
const MAX_PRODUCTS = 10;
const MAX_ADVANTAGES = 5;
const products = source.slice(0, MAX_PRODUCTS);

const stores = [
	{ id: "mercadolivre" as const, shown: (product: Product) => Boolean(product.mercadolivreUrl) },
	{ id: "shopee" as const, shown: (product: Product) => isAffiliateUrl(product.shopeeUrl) },
	{ id: "amazon" as const, shown: (product: Product) => isAffiliateUrl(product.amazonUrl) },
];
---

{
	
	products.length === 0 ? (
		<div class="my-2.5 rounded-lg bg-red-50 p-5 text-center text-red-600 dark:text-red-400">
			Nenhum produto encontrado para a lista "{list}".
		</div>
	) : (
		<div class="my-2.5 flex flex-col gap-6" data-testid="cards-table" data-cards data-shuffle={shuffle ? "true" : "false"}>
			{products.map((product) => {
				const priority = offerTarget(postSlug, product);
				const technical = specifiedDetails(product);
				return (
					<div class="grid grid-cols-6 items-stretch overflow-hidden rounded-xl border-2 bg-card text-foreground max-[768px]:grid-cols-1 ">
						<div class="col-span-3 flex flex-col items-center gap-3 p-6 text-center max-[768px]:col-span-1">
							<a
								href={priority.dashboard}
								data-direct-href={priority.direct}
								data-affiliate
								data-product-id={product.id}
								data-post-slug={postSlug}
								data-store={priority.store}
								target="_blank"
								rel="noopener noreferrer sponsored"
								class="flex h-[160px] w-[160px] shrink-0 items-center justify-center p-2.5 no-underline hover:no-underline max-[480px]:h-[140px] max-[480px]:w-[140px]"
								title={product.name}
							>
								{product.image !== "#" && (
									<img
										src={product.image}
										alt={product.name}
										class="max-h-full max-w-full object-contain object-center"
										loading="lazy"
										decoding="async"
									/>
								)}
							</a>
							<a
								href={priority.dashboard}
								data-direct-href={priority.direct}
								data-affiliate
								data-product-id={product.id}
								data-post-slug={postSlug}
								data-store={priority.store}
								target="_blank"
								rel="noopener noreferrer sponsored"
								class="line-clamp-3 max-w-100 text-[1rem] leading-snug font-bold wrap-break-word text-foreground uppercase no-underline transition-colors duration-75 hover:no-underline max-[480px]:text-[0.9rem] !"
								title={product.name}
							>
								{product.name}
							</a>
							<div class="flex w-full max-w-70 flex-col gap-2.5">
								{stores.map((store) => {
									const href = offerTarget(postSlug, product, store.id);
									const shown = store.shown(product);
									return (
										<OfferButton
											href={href.dashboard}
											direct={href.direct}
											store={store.id}
											productId={product.id}
											postSlug={postSlug}
											hidden={!shown}
											extra={!shown}
										/>
									);
								})}
							</div>
							{product.advantages.length > 0 && (
								<div class="w-full overflow-hidden rounded-lg text-left">
									<div class="flex flex-col gap-1.5 px-3 py-2.5">
										<ul class="flex flex-col gap-1.5">
											{product.advantages.slice(0, MAX_ADVANTAGES).map((advantage) => (
												<li class="flex items-start gap-2 text-lg leading-snug text-foreground ">
													<Icon name="check" class="mt-1 shrink-0 text-base text-foreground " />
													<span>{advantage}</span>
												</li>
											))}
										</ul>
									</div>
								</div>
							)}
						</div>
						{technical.length > 0 && (
							<div class="col-span-3 flex items-center p-4 max-[768px]:col-span-1 max-[768px]:pt-0">
								<div class="w-full divide-y divide-border overflow-hidden rounded-lg ">
									{technical.map((detail) => (
										<div class="flex items-center justify-between gap-4 px-3 py-2.5">
											<span class="max-w-1/2 shrink-0 text-xs leading-tight font-bold tracking-wide wrap-break-word text-foreground uppercase ">
												{detail.label}
											</span>
											<span class="min-w-0 flex-1 text-right text-lg wrap-break-word text-foreground max-[480px]:text-base ">
												{detail.value}
											</span>
										</div>
									))}
								</div>
							</div>
						)}
					</div>
				);
			})}
		</div>
	)
}

<script>
	import { initCards } from "#lib/client/cards.ts";

	initCards();
</script>
