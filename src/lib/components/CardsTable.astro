---
import { isAffiliateUrl, type Store, storeLinks } from "#lib/affiliate-links.ts";
import { fallbackHref, productHref } from "#lib/content/affiliate.ts";
import type { Product } from "#lib/content/schema.ts";
import { site } from "#lib/site.config.ts";
import Icon from "./Icon.astro";

interface Props {
	list: string;
	products: Product[];
	postSlug: string;
	shuffle?: boolean;
}

const { list, products: source, postSlug, shuffle = true } = Astro.props;
const MAX_PRODUCTS = 10;
const MAX_ADVANTAGES = 5;
const products = source.slice(0, MAX_PRODUCTS);

const storeButton =
	"inline-flex items-center justify-center gap-2 no-underline hover:no-underline py-2.5 px-5 max-[480px]:py-2 max-[480px]:px-4 rounded text-[0.8rem] max-[480px]:text-xs font-semibold transition-all duration-75 cursor-pointer w-full text-center whitespace-nowrap hover:translate-y-0.5 active:translate-y-1 focus:outline focus:outline-blue-600 focus:outline-offset-2";

function target(product: Product, store?: Store): { dashboard: string; direct: string } {
	const link = storeLinks(product).find((candidate) => !store || candidate.store === store);
	if (!link) return { dashboard: fallbackHref, direct: site.fallbackAffiliateUrl };
	return { dashboard: productHref(postSlug, product.id, link.store), direct: link.url };
}

function details(product: Product): Product["technicalDetails"] {
	return product.technicalDetails.filter(
		(detail) => detail.value && detail.value.trim().toLowerCase() !== "não especificado",
	);
}

const stores = [
	{
		id: "mercadolivre" as const,
		label: "VER PREÇO MERCADOLIVRE",
		title: "Ver preço no Mercado Livre",
		icon: "mercadopago" as const,
		iconClass: "text-black",
		textClass: "text-black",
		button:
			"bg-[#fff159] text-black shadow-[0_4px_0_0_#ccb800] hover:bg-[#e6d84f] hover:text-black hover:shadow-[0_2px_0_0_#ccb800] active:shadow-[0_0px_0_0_#ccb800]",
		shown: (product: Product) => Boolean(product.mercadolivreUrl),
	},
	{
		id: "shopee" as const,
		label: "VER PREÇO SHOPEE",
		title: "Ver preço na Shopee",
		icon: "shopee" as const,
		iconClass: "text-white",
		textClass: "text-white",
		button:
			"bg-[#ee4d2d] text-white shadow-[0_4px_0_0_#b83a20] hover:bg-[#d8431f] hover:shadow-[0_2px_0_0_#b83a20] active:shadow-[0_0px_0_0_#b83a20]",
		shown: (product: Product) => isAffiliateUrl(product.shopeeUrl),
	},
	{
		id: "amazon" as const,
		label: "VER PREÇO AMAZON",
		title: "Ver preço na Amazon",
		icon: "amazon" as const,
		iconClass: "text-[#ff9900]",
		textClass: "text-white",
		button:
			"bg-[#232f3e] text-white shadow-[0_4px_0_0_#0f151c] hover:bg-[#374357] hover:shadow-[0_2px_0_0_#0f151c] active:shadow-[0_0px_0_0_#0f151c]",
		shown: (product: Product) => isAffiliateUrl(product.amazonUrl),
	},
];
---

{
	products.length === 0 ? (
		<div class="my-2.5 rounded-lg bg-red-50 p-5 text-center text-red-600 dark:bg-black dark:text-red-400">
			Nenhum produto encontrado para a lista "{list}".
		</div>
	) : (
		<div class="my-2.5 flex flex-col gap-6" data-testid="cards-table" data-cards data-shuffle={shuffle ? "true" : "false"}>
			{products.map((product) => {
				const priority = target(product);
				const technical = details(product);
				return (
					<div class="grid grid-cols-6 items-stretch overflow-hidden rounded-xl border-2 bg-white text-black max-[768px]:grid-cols-1 dark:border-zinc-800 dark:bg-black dark:text-white">
						<div class="col-span-3 flex flex-col items-center gap-3 p-6 text-center max-[768px]:col-span-1">
							<a
								href={priority.dashboard}
								data-direct-href={priority.direct}
								target="_blank"
								rel="noopener noreferrer sponsored"
								class="flex h-[160px] w-[160px] shrink-0 items-center justify-center p-2.5 no-underline hover:no-underline max-[480px]:h-[140px] max-[480px]:w-[140px]"
								title={product.name}
							>
								{product.image !== "#" && (
									<img
										src={product.image}
										alt={product.name}
										class="max-h-full max-w-full object-contain object-center"
										loading="lazy"
										decoding="async"
									/>
								)}
							</a>
							<a
								href={priority.dashboard}
								data-direct-href={priority.direct}
								target="_blank"
								rel="noopener noreferrer sponsored"
								class="line-clamp-3 max-w-100 text-[1rem] leading-snug font-bold wrap-break-word text-black uppercase no-underline transition-colors duration-75 hover:no-underline max-[480px]:text-[0.9rem] dark:text-white!"
								title={product.name}
							>
								{product.name}
							</a>
							<div class="flex w-full max-w-70 flex-col gap-2.5">
								{stores.map((store) => {
									const href = target(product, store.id);
									const shown = store.shown(product);
									return (
										<a
											href={href.dashboard}
											data-direct-href={href.direct}
											data-extra-store={shown ? undefined : ""}
											hidden={!shown}
											target="_blank"
											rel="noopener noreferrer sponsored"
											class:list={[storeButton, store.button]}
											title={store.title}
										>
											<span class:list={["flex shrink-0 items-center text-lg max-[480px]:text-base", store.iconClass]}>
												<Icon name={store.icon} class={store.iconClass} />
											</span>
											<span class={store.textClass}>{store.label}</span>
										</a>
									);
								})}
							</div>
							{product.advantages.length > 0 && (
								<div class="w-full overflow-hidden rounded-lg text-left">
									<div class="flex flex-col gap-1.5 px-3 py-2.5">
										<ul class="flex flex-col gap-1.5">
											{product.advantages.slice(0, MAX_ADVANTAGES).map((advantage) => (
												<li class="flex items-start gap-2 text-lg leading-snug text-gray-800 dark:text-gray-300">
													<Icon name="check" class="mt-1 shrink-0 text-base text-black dark:text-white" />
													<span>{advantage}</span>
												</li>
											))}
										</ul>
									</div>
								</div>
							)}
						</div>
						{technical.length > 0 && (
							<div class="col-span-3 flex items-center p-4 max-[768px]:col-span-1 max-[768px]:pt-0">
								<div class="w-full divide-y divide-gray-200 overflow-hidden rounded-lg dark:divide-zinc-800">
									{technical.map((detail) => (
										<div class="flex items-center justify-between gap-4 px-3 py-2.5">
											<span class="max-w-1/2 shrink-0 text-xs leading-tight font-bold tracking-wide wrap-break-word text-black uppercase dark:text-white">
												{detail.label}
											</span>
											<span class="min-w-0 flex-1 text-right text-lg wrap-break-word text-gray-800 max-[480px]:text-base dark:text-gray-300">
												{detail.value}
											</span>
										</div>
									))}
								</div>
							</div>
						)}
					</div>
				);
			})}
		</div>
	)
}

<script>
	import { initCards } from "#lib/client/cards.ts";

	initCards();
</script>
