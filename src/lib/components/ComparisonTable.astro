---
import { comparisonColumns, offerTarget, specifiedDetails } from "#lib/content/review.ts";
import type { Product } from "#lib/content/schema.ts";
import OfferButton from "./OfferButton.astro";

interface Props {
	products: Product[];
	postSlug: string;
	id: string;
}

const { products, postSlug, id } = Astro.props;
const columns = comparisonColumns(products);
const cellValue = (product: Product, label: string): string =>
	specifiedDetails(product).find((detail) => detail.label === label)?.value ?? "-";
---

{
	products.length >= 2 && columns.length > 0 && (
		<section
			tabindex="0"
			aria-labelledby={id}
			class="my-6 max-h-[32rem] max-w-full overflow-auto rounded-md border border-border bg-card"
		>
			<table class="w-full border-separate border-spacing-0 text-left text-sm">
				<caption id={id} class="px-4 pt-3 pb-2 text-left text-sm font-bold text-foreground">
					Comparativo rápido
				</caption>
				<thead class="sticky top-0 z-10 bg-muted">
					<tr>
						<th scope="col" class="sticky left-0 z-10 bg-muted px-4 py-2 font-semibold">Produto</th>
						{columns.map((label) => (
							<th scope="col" class="px-4 py-2 font-semibold whitespace-nowrap">
								{label}
							</th>
						))}
						<th scope="col" class="px-4 py-2 font-semibold">Oferta</th>
					</tr>
				</thead>
				<tbody>
					{products.map((product) => {
						const target = offerTarget(postSlug, product);
						return (
							<tr>
								<th scope="row" class="sticky left-0 z-[1] min-w-44 border-t border-border bg-card px-4 py-3 font-semibold">
									{product.name}
								</th>
								{columns.map((label) => (
									<td class="border-t border-border px-4 py-3 text-muted-foreground">{cellValue(product, label)}</td>
								))}
								<td class="min-w-44 border-t border-border px-4 py-3">
									<OfferButton
										href={target.dashboard}
										direct={target.direct}
										store={target.store}
										productId={product.id}
										postSlug={postSlug}
										size="sm"
									/>
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</section>
	)
}
