---
import { site } from "#lib/site.config.ts";

interface Props {
	activeCategories?: string[];
}

const { activeCategories = [] } = Astro.props;
const year = new Date().getFullYear();
const categories = site.categories.filter((category) => activeCategories.includes(category.id));
const institutional = [
	{ href: "/sobre", label: "Sobre" },
	{ href: "/contato", label: "Contato" },
];
const legal = [
	{ href: "/termos-de-uso", label: "Termos de Uso" },
	{ href: "/politica-de-privacidade", label: "Política de Privacidade" },
];
const heading = "text-xs font-bold tracking-wider text-muted-foreground uppercase ";
const link =
	"text-sm font-semibold text-foreground transition-colors hover:text-primary ";
---

<footer class="mt-6 border-t border-border bg-background ">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-2 gap-x-8 gap-y-10 py-12 md:grid-cols-12">
			<div class="col-span-2 md:col-span-5">
				<a href="/" class="inline-flex items-center gap-2 transition-opacity hover:opacity-80">
					<img src={site.logo} alt="" width="36" height="36" loading="lazy" />
					<span class="font-brand text-xl leading-none font-bold tracking-tight text-primary ">
						{site.logoText[0]}<span class="text-primary ">{site.logoText[1]}</span>
					</span>
				</a>
				<p class="mt-4 max-w-md text-sm! leading-relaxed text-muted-foreground ">
					<span class="font-bold text-foreground ">{site.footer.tagline} </span>
					{site.footer.about}
				</p>
			</div>

			<nav class="md:col-span-3" aria-label="Categorias">
				<h2 class={heading}>Categorias</h2>
				<ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5">
					{
						categories.map((category) => (
							<li class="text-sm!">
								<a href={`/?categoria=${category.id}`} class={link}>
									{category.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="md:col-span-2" aria-label="Institucional">
				<h2 class={heading}>Institucional</h2>
				<ul class="mt-4 space-y-2.5">
					{
						institutional.map((item) => (
							<li class="text-sm!">
								<a href={item.href} class={link}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="md:col-span-2" aria-label="Legal">
				<h2 class={heading}>Legal</h2>
				<ul class="mt-4 space-y-2.5">
					{
						legal.map((item) => (
							<li class="text-sm!">
								<a href={item.href} class={link}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div
			class="flex flex-col items-center justify-between gap-2 border-t border-border py-6 sm:flex-row "
		>
			<p class="text-xs! font-semibold text-muted-foreground uppercase ">
				© {year}
				{site.domain}
			</p>
			<p class="text-xs! text-muted-foreground ">{site.footer.affiliateDisclosure}</p>
		</div>
	</div>
</footer>
