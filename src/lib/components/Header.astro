---
import { jsonForScript } from "#lib/json-script.ts";
import { site } from "#lib/site.config.ts";
import LogoMark from "./LogoMark.astro";
import Lucide from "./Lucide.astro";
import MobileSidebar from "./MobileSidebar.astro";

interface SearchItem {
	slug: string;
	title: string;
	date: string;
	cover: string;
	category: string;
}

interface Props {
	posts: SearchItem[];
}

const { posts } = Astro.props;
const iconButton =
	"inline-flex items-center justify-center w-9 h-9 rounded-lg text-muted-foreground hover:bg-muted transition-colors";
const field =
	"w-full rounded-lg border border-border bg-muted py-2.5 pr-4 pl-10 text-sm text-foreground transition-colors placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-ring/40 focus:outline-none";
---

<div
	class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl "
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<header class="text-foreground ">
			<div class="flex items-center justify-between gap-3 py-3.5 sm:gap-4">
				<button type="button" data-open-menu aria-label="Abrir menu" class:list={[iconButton, "shrink-0 lg:hidden"]}>
					<Lucide name="menu" class="h-5 w-5" />
				</button>

				<div class="shrink-0">
					<a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
						<LogoMark />
						<span class="font-brand text-xl leading-none font-bold tracking-tight text-foreground">
							{site.logoText[0]}<span class="text-primary ">{site.logoText[1]}</span>
						</span>
					</a>
				</div>

				<div class="relative mx-2 hidden flex-1 lg:flex" data-search>
					<Lucide
						name="search"
						class="pointer-events-none absolute top-1/2 left-3.5 z-10 h-4 w-4 -translate-y-1/2 text-muted-foreground"
					/>
					<input type="text" aria-label="Buscar" placeholder="Buscar postagem, produto, marca..." class={field} />
				</div>

				<div class="ml-auto flex shrink-0 items-center gap-1 sm:gap-2">
					<button type="button" data-search-toggle aria-label="Buscar" class:list={[iconButton, "lg:hidden"]}>
						<span data-search-open-icon><Lucide name="search" class="h-5 w-5" /></span>
						<span data-search-close-icon hidden><Lucide name="x" class="h-5 w-5" /></span>
					</button>

					<button type="button" data-theme-toggle aria-label="Alternar tema" class={iconButton}>
						<span class="hidden dark:inline-flex"><Lucide name="sun" class="h-5 w-5" /></span>
						<span class="inline-flex dark:hidden"><Lucide name="moon" class="h-5 w-5" /></span>
					</button>
				</div>
			</div>

			<div class="pb-4 lg:hidden" data-mobile-search hidden>
				<div class="relative" data-search>
					<Lucide
						name="search"
						class="pointer-events-none absolute top-1/2 left-3.5 z-10 h-4 w-4 -translate-y-1/2 text-muted-foreground"
					/>
					<input
						type="text"
						aria-label="Buscar"
						placeholder="Buscar postagem, produto, marca..."
						class="w-full rounded-lg border border-border bg-muted py-2.5 pr-4 pl-10 text-sm text-foreground placeholder:text-muted-foreground "
					/>
				</div>
			</div>
		</header>
	</div>
</div>

<MobileSidebar categories={[...new Set(posts.map((post) => post.category))]} />
<script id="search-index" type="application/json" set:html={jsonForScript(posts)}></script>

<script>
	import { initHeader, readSearchIndex } from "#lib/client/header.ts";

	initHeader(readSearchIndex());
</script>
