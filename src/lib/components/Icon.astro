---
import { type IconName, icons } from "#lib/icons/icons.ts";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = "" } = Astro.props;
const icon = icons[name];
---

<svg
	class={className}
	viewBox={icon.viewBox}
	width="1em"
	height="1em"
	fill="currentColor"
	stroke="currentColor"
	stroke-width="0"
	aria-hidden="true"
>
	{icon.paths.map((d) => <path d={d} />)}
</svg>
