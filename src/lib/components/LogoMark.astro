---
import { site } from "#lib/site.config.ts";

// The favicon's own colors follow the OS theme, not the site toggle; as a mask the mark takes the text color instead.
interface Props {
	size?: number;
}

const { size = 36 } = Astro.props;
---

<span
	aria-hidden="true"
	class="inline-block shrink-0 bg-foreground"
	style={`width:${size}px;height:${size}px;-webkit-mask:url(${site.logo}) center/contain no-repeat;mask:url(${site.logo}) center/contain no-repeat`}
></span>
