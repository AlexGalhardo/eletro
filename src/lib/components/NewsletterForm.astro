<form data-newsletter class="mx-auto max-w-md text-center">
	<label for="newsletter-email" class="text-xs font-bold tracking-wider text-muted-foreground uppercase ">
		Receba as novas análises por e-mail
	</label>
	<div class="mt-3 flex justify-center gap-2">
		<input
			id="newsletter-email"
			type="email"
			name="email"
			autocomplete="email"
			required
			placeholder="seuemail@email.com"
			class="w-full rounded-lg border border-input bg-card px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-ring/40 focus:outline-none "
		/>
		<button
			type="submit"
			class="shrink-0 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
		>
			Inscrever
		</button>
	</div>
	<p data-newsletter-status role="status" hidden class="mt-3 text-sm!"></p>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
	const status = form?.querySelector<HTMLElement>("[data-newsletter-status]");
	const button = form?.querySelector("button");
	const input = form?.querySelector("input");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!input || !button || !status) return;
		button.disabled = true;
		button.textContent = "Enviando...";
		status.hidden = true;
		try {
			const response = await fetch("/api/v1/newsletter/subscribers", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email: input.value }),
			});
			if (!response.ok) throw new Error(`Subscription request failed with ${response.status}`);
			status.textContent = "Quase lá: confirme a inscrição pelo link que enviamos ao seu e-mail.";
			status.className = "mt-3 text-sm! text-green-700 dark:text-green-400";
			input.value = "";
		} catch {
			status.textContent = "Não foi possível inscrever agora. Confira o e-mail e tente de novo.";
			status.className = "mt-3 text-sm! text-red-600 dark:text-red-400";
		} finally {
			status.hidden = false;
			button.disabled = false;
			button.textContent = "Inscrever";
		}
	});
</script>
