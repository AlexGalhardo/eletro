---
import type { Store } from "#lib/affiliate-links.ts";
import { site } from "#lib/site.config.ts";

// The only affiliate call to action of the site. Colors per store live in src/app.css (`.offer-btn`).
interface Props {
	href: string;
	direct: string;
	store: Store;
	productId: string;
	postSlug: string;
	size?: "default" | "sm";
	hidden?: boolean;
	extra?: boolean;
	class?: string;
}

const { href, direct, store, productId, postSlug, size = "default", hidden = false, extra = false, class: className = "" } =
	Astro.props;
const { name, article } = site.stores[store];
---

<a
	href={href}
	data-direct-href={direct}
	data-extra-store={extra ? "" : undefined}
	data-affiliate
	data-product-id={productId}
	data-post-slug={postSlug}
	data-store={store}
	hidden={hidden}
	target="_blank"
	rel="noopener noreferrer sponsored"
	class:list={[
		"offer-btn inline-flex w-full items-center justify-center gap-2 rounded-md font-semibold whitespace-nowrap no-underline hover:no-underline",
		size === "sm" ? "px-3 py-1.5 text-xs" : "px-5 py-2.5 text-sm",
		className,
	]}
>
	Ver oferta {article} {name}<span class="sr-only"> (abre em nova aba)</span>
</a>

<script>
	import { trackAffiliateClicks } from "#lib/client/affiliate-click.ts";

	trackAffiliateClicks();
</script>
