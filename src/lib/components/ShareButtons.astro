---
import type { IconName } from "#lib/icons/icons.ts";
import Icon from "./Icon.astro";

interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const links: { name: string; href: string; color: string; icon: IconName }[] = [
	{
		name: "Twitter",
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
		color: "bg-black hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200",
		icon: "xTwitter",
	},
	{
		name: "Facebook",
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
		color: "bg-blue-600 hover:bg-blue-700",
		icon: "facebookF",
	},
	{
		name: "WhatsApp",
		href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
		color: "bg-green-500 hover:bg-green-600",
		icon: "whatsapp",
	},
	{
		name: "Telegram",
		href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
		color: "bg-blue-400 hover:bg-blue-500",
		icon: "telegram",
	},
	{
		name: "LinkedIn",
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
		color: "bg-blue-700 hover:bg-blue-800",
		icon: "linkedinIn",
	},
	{
		name: "Reddit",
		href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
		color: "bg-orange-500 hover:bg-orange-600",
		icon: "reddit",
	},
	{
		name: "Pinterest",
		href: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`,
		color: "bg-red-600 hover:bg-red-700",
		icon: "pinterest",
	},
];
---

<div class="flex flex-nowrap items-center gap-1.5 overflow-x-auto sm:gap-2" data-share data-url={url}>
	{
		links.map((item) => (
			<a
				href={item.href}
				target="_blank"
				rel="noopener noreferrer"
				class:list={[
					item.color,
					"flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] text-white transition-all duration-200 hover:scale-110 sm:h-9 sm:w-9 sm:text-sm",
				]}
				title={`Compartilhar no ${item.name}`}
				aria-label={`Compartilhar no ${item.name}`}
			>
				<Icon name={item.icon} />
			</a>
		))
	}

	<div class="relative inline-flex">
		<button
			type="button"
			data-copy
			class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-600 text-sm font-bold text-white transition-colors hover:bg-gray-700"
			title="Copiar link"
			aria-label="Copiar link"
		>
			<span data-icon="copy"><Icon name="copy" /></span>
			<span data-icon="check" hidden><Icon name="check" /></span>
		</button>
		<span
			data-status
			hidden
			role="status"
			class="absolute -top-8 left-1/2 -translate-x-1/2 rounded-md px-2 py-1 text-xs font-medium whitespace-nowrap text-white"
		></span>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-share]")) {
		const button = root.querySelector<HTMLButtonElement>("[data-copy]");
		const status = root.querySelector<HTMLElement>("[data-status]");
		const copyIcon = root.querySelector<HTMLElement>('[data-icon="copy"]');
		const checkIcon = root.querySelector<HTMLElement>('[data-icon="check"]');
		let timer: ReturnType<typeof setTimeout> | undefined;
		button?.addEventListener("click", async () => {
			let copied: "success" | "error" = "success";
			try {
				await navigator.clipboard.writeText(root.dataset.url ?? "");
			} catch {
				copied = "error";
			}
			if (copyIcon) copyIcon.hidden = copied === "success";
			if (checkIcon) checkIcon.hidden = copied !== "success";
			if (status) {
				status.hidden = false;
				status.textContent = copied === "success" ? "Link copiado!" : "Erro ao copiar";
				status.classList.remove("bg-green-600", "bg-red-600");
				status.classList.add(copied === "success" ? "bg-green-600" : "bg-red-600");
			}
			clearTimeout(timer);
			timer = setTimeout(() => {
				if (status) status.hidden = true;
				if (copyIcon) copyIcon.hidden = false;
				if (checkIcon) checkIcon.hidden = true;
			}, 2000);
		});
	}
</script>
