---
import { site } from "#lib/site.config.ts";
import Root from "../layouts/Root.astro";
---

<Root title={`404 - Página Não Encontrada`} description={site.description} path="/404.html" noindex>
	<div class="flex min-h-screen items-center justify-center bg-background px-4 ">
		<div class="max-w-lg text-center">
			<p class="text-sm font-semibold text-primary ">Erro 404</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight text-foreground ">Página não encontrada</h1>
			<p class="mt-4 text-base leading-7 text-muted-foreground ">O endereço pode ter mudado. Volte ao início e encontre outras análises.</p>
			<a href="/" class="mt-7 inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
				Ver publicações
			</a>
		</div>
	</div>
</Root>
