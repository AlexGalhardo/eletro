---
import { site } from "#lib/site.config.ts";
import Root from "../layouts/Root.astro";
---

<Root title={`404 - Página Não Encontrada`} description={site.description} path="/404" noindex>
	<div class="flex min-h-screen items-center justify-center bg-white dark:bg-black">
		<div class="text-center">
			<h1 class="mb-4 text-4xl font-bold text-black dark:text-white">404</h1>
			<p class="mb-4 text-black dark:text-white">Página Não Encontrada</p>
			<a href="/" class="text-sm font-semibold text-blue-600 hover:underline dark:text-blue-400">
				Voltar para o início
			</a>
		</div>
	</div>
</Root>
