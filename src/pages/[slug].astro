---
import { isPublished } from "#lib/content/parse.ts";
import { postJsonLd } from "#lib/seo/jsonld.ts";
import { getSitePost, getSitePosts, postPageData } from "#lib/server/content.ts";
import Site from "../layouts/Site.astro";
import PostPage from "../routes/(site)/[slug]/page.astro";

export function getStaticPaths() {
	return getSitePosts().map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug ?? "";
const entry = getSitePost(slug);
if (!entry) throw new Error(`Post ausente no build: ${slug}`);
const data = postPageData(entry);
---

<Site
	title={entry.post.title}
	description={entry.post.description}
	path={`/${entry.post.slug}`}
	image={entry.post.cover}
	type="article"
	publishedTime={entry.post.date}
	jsonLd={postJsonLd(entry.post)}
	noindex={!isPublished(entry.post)}
>
	<PostPage data={data} />
</Site>
