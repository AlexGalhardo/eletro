---
import { referencedLists } from "#lib/content/parse.ts";
import { renderPostBody } from "#lib/content/render-body.ts";
import type { Product } from "#lib/content/schema.ts";
import { postJsonLd } from "#lib/seo/jsonld.ts";
import { coverWidths, getPost, getPosts, getProductList } from "#lib/server/content.ts";
import Site from "../layouts/Site.astro";
import PostPage from "../routes/(site)/[slug]/page.svelte";

export function getStaticPaths() {
	return getPosts().map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug ?? "";
const entry = getPost(slug);
if (!entry) throw new Error(`Post ausente no build: ${slug}`);

const productLists: Record<string, Product[]> = {};
for (const list of referencedLists(entry.body)) {
	const products = getProductList(list);
	if (products) productLists[list] = products;
}

const data = {
	post: entry.post,
	coverWidths: coverWidths(entry.post.cover),
	productLists,
	segments: renderPostBody(entry.body),
};
---

<Site
	title={entry.post.title}
	description={entry.post.description}
	path={`/${entry.post.slug}`}
	image={entry.post.cover}
	type="article"
	publishedTime={entry.post.date}
	jsonLd={postJsonLd(entry.post)}
>
	<PostPage data={data} client:load />
</Site>
