---
import PagesCms from "#lib/admin/PagesCms.astro";
import Admin from "../../layouts/Admin.astro";

export function getStaticPaths() {
	// Every route opens the same static editor on GitHub Pages; the folder it starts in follows the route.
	return ["posts", "products", "media", "import"].map((path) => ({ params: { path } }));
}

const path = Astro.params.path ?? "posts";
const folders: Record<string, string> = { products: "content/products", media: "static/images" };
---

<Admin section={path === "posts" ? "posts" : "products"} path={`/admin/${path}`}>
	<PagesCms folder={folders[path] ?? "content/posts"} />
</Admin>
