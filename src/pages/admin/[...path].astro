---
import PagesCms from "#lib/admin/PagesCms.astro";
import { site } from "#lib/site.config.ts";
import Root from "../../layouts/Root.astro";

export function getStaticPaths() {
	// Every route opens the same static editor on GitHub Pages.
	return ["login", "posts", "products", "media", "newsletter", "import", "google"].map((path) => ({
		params: { path },
	}));
}

const path = Astro.params.path ?? "login";
---

<Root title={`Painel editorial - ${site.name}`} description="Edite o conteúdo do site." path={`/admin/${path}`} noindex>
	<PagesCms />
</Root>
