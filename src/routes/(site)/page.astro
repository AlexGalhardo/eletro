---
import CategoryIcon from "#lib/components/CategoryIcon.astro";
import CookieBanner from "#lib/components/CookieBanner.astro";
import ReadingProgress from "#lib/components/ReadingProgress.astro";
import { coverSrcset } from "#lib/content/cover.ts";
import type { Post } from "#lib/content/schema.ts";
import { formatDate } from "#lib/format.ts";
import { site } from "#lib/site.config.ts";

const POSTS_PER_LOAD = 8;

type Card = Pick<Post, "slug" | "title" | "description" | "cover" | "date" | "category"> & {
	coverWidths: number[];
};

interface Props {
	data: { posts: Card[]; activeCategories: string[] };
}

const { data } = Astro.props;
const categories = [
	{ id: "all", label: "Todos", icon: "layers" },
	...site.categories.filter((category) => data.activeCategories.includes(category.id)),
];
const counts = new Map<string, number>([["all", data.posts.length]]);
for (const post of data.posts) counts.set(post.category, (counts.get(post.category) ?? 0) + 1);

const on =
	"border-primary bg-primary text-primary-foreground";
const off =
	"border-border text-muted-foreground hover:border-primary hover:text-primary ";
const button =
	"flex w-full cursor-pointer items-center gap-1.5 rounded-lg border px-3 py-2 text-xs font-semibold tracking-wide uppercase transition-colors duration-200";
---

<ReadingProgress />
<CookieBanner />

<main data-home class="min-h-screen bg-background text-foreground ">
	<h1 class="sr-only">{site.name}</h1>
	<div class="mx-auto max-w-6xl px-3 sm:px-6 lg:grid lg:grid-cols-[14rem_1fr] lg:items-start lg:gap-8 lg:px-8 lg:py-8">
		<aside
			aria-label="Filtrar por categoria"
			class="sticky top-24 hidden max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-border bg-card lg:block "
		>
			<h2 class="px-4 pt-4 text-xs font-bold tracking-wide text-muted-foreground uppercase ">Categorias</h2>
			<div class="flex flex-col gap-1.5 p-3">
				{
					categories.map((category) => (
						<button
							type="button"
							data-filter={category.id}
							data-label={category.label}
							aria-pressed={category.id === "all" ? "true" : "false"}
							class:list={[button, category.id === "all" ? on : off]}
						>
							<CategoryIcon name={category.icon} class="h-3.5 w-3.5 shrink-0" />
							<span class="min-w-0 flex-1 truncate text-left">{category.label}</span>
							<span class="shrink-0 tabular-nums">{counts.get(category.id) ?? 0}</span>
						</button>
					))
				}
			</div>
		</aside>

		<div class="py-8 lg:py-0">
			<p data-filter-banner hidden class="mb-4 text-sm text-muted-foreground lg:hidden " aria-live="polite">
				Categoria: <strong data-filter-name class="text-foreground "></strong>
				·
				<button type="button" data-filter-clear class="cursor-pointer text-primary underline ">
					Ver todas
				</button>
			</p>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
				{
					data.posts.map((post, index) => (
						<a
							href={`/${post.slug}`}
							data-post
							data-category={post.category}
							hidden={index >= POSTS_PER_LOAD}
							class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow duration-200 hover:shadow-lg "
						>
							{post.cover && (
								<div class="relative aspect-video w-full shrink-0 overflow-hidden bg-muted ">
									<img
										src={post.cover}
										srcset={coverSrcset(post.cover, post.coverWidths)}
										sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 100vw"
										alt={post.title}
										decoding="async"
										loading={index < 2 ? "eager" : "lazy"}
										fetchpriority={index < 2 ? "high" : "auto"}
										class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
									/>
								</div>
							)}
							<div class="flex flex-1 flex-col gap-2 p-4">
								<span class="text-[11px] font-medium text-muted-foreground ">
									POSTADO EM {formatDate(post.date).toUpperCase()}
								</span>
								<h3 class="line-clamp-2 text-base leading-snug font-bold text-foreground transition-colors duration-300 group-hover:text-primary dark:group-hover:text-primary">
									{post.title}
								</h3>
								<p class="line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground ">
									{post.description}
								</p>
							</div>
						</a>
					))
				}
				<div data-empty hidden={data.posts.length > 0} class="col-span-full py-20 text-center">
					<p class="text-lg text-muted-foreground ">Nenhuma postagem encontrada nesta categoria.</p>
				</div>
			</div>
			<div data-sentinel class="flex justify-center pt-8"></div>
		</div>
	</div>
</main>

<script>
	import { initHome } from "#lib/client/home.ts";

	initHome();
</script>
