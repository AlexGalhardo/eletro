---
import Lucide from "#lib/components/Lucide.astro";
import { site } from "#lib/site.config.ts";

interface Props {
	admin: { githubLogin?: string | null; email?: string | null } | null;
}

const { admin } = Astro.props;
const links = [
	{ href: "/admin", label: "Painel" },
	{ href: "/admin/posts", label: "Posts" },
	{ href: "/admin/products", label: "Produtos" },
	{ href: "/admin/media", label: "Mídia" },
	{ href: "/admin/newsletter", label: "Newsletter" },
	{ href: "/admin/import", label: "Importar" },
	{ href: "/admin/google", label: "Google" },
];
---

<div class="min-h-screen bg-gray-50 text-black dark:bg-black dark:text-white" data-admin-shell>
	{
		admin && (
			<header class="border-b border-gray-200 bg-white dark:border-zinc-800 dark:bg-zinc-950">
				<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
					<a href="/admin" class="font-russo-one text-lg">
						{site.name} <span class="text-blue-600">Admin</span>
					</a>
					<button
						type="button"
						data-admin-menu-toggle
						aria-expanded="false"
						aria-controls="admin-menu"
						aria-label="Abrir menu"
						class="flex h-10 w-10 items-center justify-center rounded-md border border-gray-300 hover:bg-gray-100 md:hidden dark:border-zinc-700 dark:hover:bg-zinc-800"
					>
						<span data-admin-menu-open><Lucide name="menu" class="h-5 w-5" /></span>
						<span data-admin-menu-close hidden><Lucide name="x" class="h-5 w-5" /></span>
					</button>
					<div
						id="admin-menu"
						data-admin-menu
						class="hidden w-full flex-col gap-3 border-t border-gray-200 pt-3 md:flex md:w-auto md:flex-1 md:flex-row md:items-center md:gap-6 md:border-0 md:pt-0 dark:border-zinc-800"
					>
						<nav aria-label="Painel" class="flex flex-col gap-1 md:flex-1 md:flex-row md:flex-wrap">
							{links.map((link) => (
								<a
									href={link.href}
									data-admin-link
									data-href={link.href}
									class="rounded-md px-3 py-2 text-base font-medium hover:bg-gray-100 aria-[current=page]:bg-gray-100 md:py-1.5 md:text-sm dark:hover:bg-zinc-800 dark:aria-[current=page]:bg-zinc-800"
								>
									{link.label}
								</a>
							))}
						</nav>
						<div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-3 md:px-0">
							<a href="/" target="_blank" rel="noopener" class="flex items-center gap-1 text-sm text-gray-600 hover:underline dark:text-gray-400">
								Ver site <Lucide name="external-link" class="h-3.5 w-3.5" />
							</a>
							<span class="text-sm text-gray-600 dark:text-gray-400">{admin.githubLogin ?? admin.email}</span>
							<button
								type="button"
								data-theme-toggle
								aria-label="Alternar tema"
								class="flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 hover:bg-gray-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
							>
								<span class="hidden dark:inline-flex"><Lucide name="sun" class="h-4 w-4" /></span>
								<span class="inline-flex dark:hidden"><Lucide name="moon" class="h-4 w-4" /></span>
							</button>
							<button
								type="button"
								data-sign-out
								class="flex items-center gap-1 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium hover:bg-gray-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
							>
								<Lucide name="log-out" class="h-3.5 w-3.5" /> Sair
							</button>
						</div>
					</div>
				</div>
			</header>
		)
	}
	<main class="mx-auto max-w-6xl px-4 py-8">
		<slot />
	</main>
</div>

<script>
	import { bindThemeToggles } from "#lib/theme.ts";

	bindThemeToggles();
	const path = location.pathname;
	const menu = document.querySelector<HTMLElement>("[data-admin-menu]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-admin-menu-toggle]");
	const openIcon = document.querySelector<HTMLElement>("[data-admin-menu-open]");
	const closeIcon = document.querySelector<HTMLElement>("[data-admin-menu-close]");

	function closeMenu(): void {
		if (!menu || !toggle) return;
		menu.classList.add("hidden");
		menu.classList.remove("flex");
		toggle.setAttribute("aria-expanded", "false");
		toggle.setAttribute("aria-label", "Abrir menu");
		if (openIcon) openIcon.hidden = false;
		if (closeIcon) closeIcon.hidden = true;
	}

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-admin-link]")) {
		const href = link.dataset.href ?? "";
		const current = href === "/admin" ? path === href : path.startsWith(href);
		if (current) link.setAttribute("aria-current", "page");
		link.addEventListener("click", () => closeMenu());
	}
	toggle?.addEventListener("click", () => {
		if (!menu || !toggle) return;
		const open = menu.classList.toggle("flex");
		menu.classList.toggle("hidden", !open);
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
		if (openIcon) openIcon.hidden = open;
		if (closeIcon) closeIcon.hidden = !open;
	});
	document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
		await fetch("/api/auth/sign-out", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: "{}",
		});
		location.href = "/admin/login";
	});
</script>
