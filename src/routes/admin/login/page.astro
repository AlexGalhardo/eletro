---
import { ui } from "#lib/admin/api.ts";
import { site } from "#lib/site.config.ts";

interface Props {
	data: { missing: string[]; github: boolean; google: boolean; local: boolean };
}

const { data } = Astro.props;
---

<div
	class="mx-auto mt-16 max-w-sm rounded-xl border border-border bg-card p-8 text-center "
	data-login
>
	<h1 class="font-russo-one text-2xl">{site.name} <span class="text-primary">Admin</span></h1>

	{
		data.missing.length > 0 ? (
			<>
				<p class="mt-4 text-sm text-muted-foreground ">
					O painel ainda não está configurado. Defina as variáveis de ambiente abaixo e reinicie o servidor.
				</p>
				<ul class="mt-4 space-y-1">
					{data.missing.map((name) => (
						<li class="font-mono text-sm">{name}</li>
					))}
				</ul>
			</>
		) : data.github || data.google ? (
			<>
				<p class="mt-4 text-sm text-muted-foreground ">Acesso restrito a quem administra o site.</p>
				{data.github && (
					<button
						type="button"
						data-provider="github"
						class="mt-6 w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 "
					>
						Entrar com GitHub
					</button>
				)}
				{data.google && (
					<button
						type="button"
						data-provider="google"
						class:list={[
							data.github ? "mt-3" : "mt-6",
							"w-full rounded-lg border border-input bg-card py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted disabled:cursor-not-allowed disabled:opacity-60 ",
						]}
					>
						Entrar com Google
					</button>
				)}
			</>
		) : (
			<p class="mt-4 text-sm text-muted-foreground ">O login pelo GitHub ou Google não está configurado.</p>
		)
	}

	{
		data.missing.length === 0 && data.local && (
			<form data-local class="mt-6 space-y-3 border-t border-border pt-6 text-left ">
				<p class="text-xs text-muted-foreground ">
					Entrada local, para desenvolvimento: existe só com o banco embutido e com AUTH_TEST_LOGIN_TOKEN definido.
				</p>
				<div>
					<label for="local-user" class={ui.label}>
						Usuário do GitHub
					</label>
					<input id="local-user" name="githubLogin" required autocomplete="username" class={ui.input} />
				</div>
				<div>
					<label for="local-token" class={ui.label}>
						Token de teste
					</label>
					<input id="local-token" name="token" type="password" required autocomplete="off" class={ui.input} />
				</div>
				<button type="submit" class:list={[ui.button, "w-full"]}>
					Entrar localmente
				</button>
			</form>
		)
	}

	<p data-login-error hidden role="alert" class="mt-4 text-sm text-red-600 dark:text-red-400">
		Não foi possível entrar. Confira se o seu usuário do GitHub ou o seu e-mail está na lista de administradores.
	</p>
</div>

<script>
	const root = document.querySelector<HTMLElement>("[data-login]");
	const failed = root?.querySelector<HTMLElement>("[data-login-error]");
	if (failed && new URL(location.href).searchParams.has("error")) failed.hidden = false;

	let loading = false;
	const buttons = [...(root?.querySelectorAll<HTMLButtonElement>("button") ?? [])];

	function setLoading(value: boolean): void {
		loading = value;
		for (const button of buttons) {
			button.disabled = value;
			const provider = button.dataset.provider;
			if (provider === "github") button.textContent = value ? "Redirecionando..." : "Entrar com GitHub";
			if (provider === "google") button.textContent = value ? "Redirecionando..." : "Entrar com Google";
		}
	}

	function fail(): void {
		setLoading(false);
		if (failed) failed.hidden = false;
	}

	for (const button of root?.querySelectorAll<HTMLButtonElement>("[data-provider]") ?? []) {
		button.addEventListener("click", async () => {
			if (loading) return;
			setLoading(true);
			if (failed) failed.hidden = true;
			try {
				const response = await fetch("/api/auth/sign-in/social", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						provider: button.dataset.provider,
						callbackURL: "/admin",
						errorCallbackURL: "/admin/login",
					}),
				});
				const payload = (await response.json()) as { url?: string };
				if (!response.ok || !payload.url) throw new Error(`Sign-in request failed with ${response.status}`);
				location.href = payload.url;
			} catch {
				fail();
			}
		});
	}

	root?.querySelector<HTMLFormElement>("[data-local]")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		if (!(form instanceof HTMLFormElement) || loading) return;
		setLoading(true);
		if (failed) failed.hidden = true;
		const body = {
			githubLogin: form.querySelector<HTMLInputElement>("#local-user")?.value ?? "",
			token: form.querySelector<HTMLInputElement>("#local-token")?.value ?? "",
		};
		try {
			const response = await fetch("/api/test/login", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(body),
			});
			if (!response.ok) throw new Error(`Local sign-in failed with ${response.status}`);
			location.href = "/admin";
		} catch {
			fail();
		}
	});
</script>
