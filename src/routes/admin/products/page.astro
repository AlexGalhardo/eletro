---
import { ui } from "#lib/admin/api.ts";

interface ListRow {
	name: string;
	deployed: boolean;
	usedBy: string[];
	products: { image: string; name: string }[];
}

interface Props {
	data: { lists: ListRow[] };
}

const { data } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-3">
	<h1 class="text-2xl font-bold">Listas de produtos</h1>
	<a href="/admin/products/new" class={ui.primary}>Nova lista</a>
</div>

<div class="mt-6 grid gap-3 md:grid-cols-[2fr_1fr]">
	<div>
		<label for="search" class={ui.label}>Buscar</label>
		<input id="search" type="search" placeholder="Nome da lista" class={ui.input} />
	</div>
	<div>
		<label for="usage" class={ui.label}>Uso</label>
		<select id="usage" class={ui.input}>
			<option value="">Todas</option>
			<option value="used">Em uso</option>
			<option value="unused">Sem uso</option>
		</select>
	</div>
</div>

<p id="list-count" class="mt-4 text-sm text-gray-600 dark:text-gray-400" aria-live="polite">{data.lists.length} lista(s)</p>

<ul class:list={[ui.card, "mt-2 divide-y divide-gray-200 dark:divide-zinc-800"]}>
	{
		data.lists.map((list) => (
			<li data-list-row data-name={list.name} data-used={list.usedBy.length > 0 ? "used" : "unused"} class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 text-sm">
				<span>
					<a href={`/admin/products/${list.name}`} class="font-medium hover:underline">{list.name}</a>
					{!list.deployed && <span class="text-amber-600 dark:text-amber-400"> · aguardando deploy</span>}
				</span>
				<span class="text-gray-600 dark:text-gray-400">
					{list.usedBy.length === 0
						? "Sem uso"
						: list.usedBy.map((slug, index) => (
								<>
									{index > 0 ? ", " : "Usada em: "}
									<a href={`/admin/posts/${slug}`} class="hover:underline">{slug}</a>
								</>
							))}
				</span>
				{list.products.length > 0 && (
					<ul class="flex w-full flex-wrap gap-2" aria-label={`Imagens dos produtos de ${list.name}`}>
						{list.products.map((product) => (
							<li>
								<img src={product.image} alt={product.name} title={product.name} loading="lazy" class="h-14 w-14 rounded border border-gray-200 bg-white object-contain dark:border-zinc-800" />
							</li>
						))}
					</ul>
				)}
			</li>
		))
	}
	<li data-list-empty hidden class="py-4 text-center text-sm text-gray-500">Nenhuma lista encontrada.</li>
</ul>

<script>
	const search = document.querySelector<HTMLInputElement>("#search");
	const usage = document.querySelector<HTMLSelectElement>("#usage");
	const count = document.querySelector<HTMLElement>("#list-count");
	const rows = [...document.querySelectorAll<HTMLElement>("[data-list-row]")];
	const empty = document.querySelector<HTMLElement>("[data-list-empty]");
	function filter(): void {
		const term = (search?.value ?? "").trim().toLowerCase();
		let shown = 0;
		for (const row of rows) {
			const visible = (row.dataset.name ?? "").includes(term) && (!usage?.value || row.dataset.used === usage.value);
			row.hidden = !visible;
			if (visible) shown += 1;
		}
		if (empty) empty.hidden = shown > 0;
		if (count) count.textContent = `${shown} lista(s)`;
	}
	search?.addEventListener("input", filter);
	usage?.addEventListener("change", filter);
	filter();
</script>
