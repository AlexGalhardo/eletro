# Netlify: headers for the prerendered pages and static files. Keep in step with vercel.json and src/hooks.server.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Images change rarely and uploads never reuse a name: a week in the browser, refreshed in the background after that.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
